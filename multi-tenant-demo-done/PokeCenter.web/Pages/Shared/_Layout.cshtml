@using Pokedex.Framework
@inject Tenant Tenant
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] — PokeCenter</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet"/>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/PokeCenter.web.styles.css" asp-append-version="true"/>
    <style>
        :root {
            --tenant-color: @Tenant.Color;
            --tenant-city-image: url('@Tenant.CityImage');
        }
    </style>
</head>
<body>
<div class="city-bg"></div>
<div class="gb-scanlines"></div>

<header>
    <nav class="gb-navbar">
        <div class="container">
            <a class="gb-brand" asp-area="" asp-page="/Index">
                <span class="gb-logo-icon">⊕</span> POKECENTER
            </a>
            <div class="gb-nav-links">
                <a class="gb-nav-link" asp-area="" asp-page="/Index">HOME</a>
                <a class="gb-nav-link" asp-area="" asp-page="/Pods">PODS</a>
            </div>
            <div class="gb-nav-auth">
                <partial name="_LoginPartial"/>
            </div>
        </div>
    </nav>
</header>

<div class="gb-content container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="gb-footer">
    <div class="container">
        <span>© 2026 POKECENTER — @Tenant.Name.ToUpper()</span>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
