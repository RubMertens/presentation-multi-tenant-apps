@page
@using Pokedex.Framework
@model PokeCenter.web.Pages.IndexModel
@inject Tenant Tenant
@{
    ViewData["Title"] = "Home";
}

<div class="gb-start-screen">

    <div class="gb-city-frame">
        <img src="@Tenant.CityImage" alt="@Tenant.Name" class="gb-city-img"/>
    </div>

    <div class="gb-title-block">
        <div class="gb-title-main">POKECENTER</div>
        <div class="gb-title-sub">@Tenant.Name.ToUpper()</div>
    </div>

    <div class="gb-menu-links">
        <a asp-page="/Pods" class="gb-menu-item">
            <span class="gb-arrow">▶</span> HEALING PODS
        </a>
    </div>

    <div class="gb-copyright">MULTI-TENANT DEMO &nbsp;—&nbsp; @Tenant.Name.ToUpper()</div>

</div>
